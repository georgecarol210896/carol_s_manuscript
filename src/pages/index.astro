---
import BaseLayout from '../layouts/BaseLayout.astro';
import Divider from '../components/Divider.astro';
import PostCard from '../components/PostCard.astro';
import { getCollection } from 'astro:content';

const base = import.meta.env.BASE_URL;

const theology = (await getCollection('tuned-theology', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const startups = (await getCollection('startup-starters', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const recent = [...theology, ...startups]
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 6);
---

<BaseLayout>
  <div class="max-w-reading mx-auto px-6 py-16">
    <header class="text-center mb-12">
      <h1 class="font-accent text-4xl md:text-5xl text-primary mb-4">Carol's Manuscript</h1>
      <p class="font-accent text-xl text-secondary">Morning by morning, new mercies gather here.</p> 
</header>
<meta name="google-site-verification" content="rTiyGBcPxbSmcEk6XToqzNokf9FyaTDHHUr6kSX4ecY" />
    <Divider />

    <section class="grid sm:grid-cols-2 gap-4 my-12">
      <a href={`${base}tuned-theology`} class="no-underline block border border-border rounded-lg p-6 bg-surface hover:border-byzantine transition-colors text-center">
        <h2 class="font-heading text-xl font-semibold text-byzantine mb-2">Tuned Theology</h2>
        <p class="text-sm text-secondary">Liturgical seasons, doctrine, and biblical reflection.</p>
      </a>
      <a href={`${base}startup-starters`} class="no-underline block border border-border rounded-lg p-6 bg-surface hover:border-teal transition-colors text-center">
        <h2 class="font-heading text-xl font-semibold text-teal mb-2">Startup Starters</h2>
        <p class="text-sm text-secondary">Architecture, tooling, and founder operations.</p>
      </a>
    </section>

    {recent.length > 0 && (
      <>
        <Divider />
        <section>
          <h2 class="font-heading text-2xl font-semibold mb-6">Recent Writing</h2>
          <div class="space-y-4">
            {recent.map(post => {
              const section = post.collection;
              return (
                <PostCard
                  title={post.data.title}
                  date={post.data.date}
                  description={post.data.description}
                  href={`${base}${section}/${post.id.replace(/\.md$/, '')}`}
                />
              );
            })}
          </div>
        </section>
      </>
    )}
  </div>
</BaseLayout>
